@using Microsoft.AspNetCore.Components.Authorization
@using TechLogistics.Web.Components.Layout

<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="new[] { typeof(TechLogistics.Client._Imports).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <p class="tl-not-found">No tiene permisos para acceder a esta sección.</p>
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p class="tl-not-found">No se encontró la página solicitada.</p>
        </LayoutView>
    </NotFound>
</Router>
