@page "/login"

<PageTitle>Iniciar sesión — TechLogistics S.A.</PageTitle>

<div class="tl-login-page">
    <div class="tl-login-card">
        <div class="tl-login-brand">
            <div class="tl-nav-logo" style="width: 44px; height: 44px; border-radius: 12px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                    <path d="m3.3 7 8.7 5 8.7-5"></path>
                    <path d="M12 22V12"></path>
                </svg>
            </div>
            <div>
                <div class="tl-nav-brand" style="color: #0f172a; font-size: 1.15rem;">TechLogistics S.A.</div>
                <div style="font-size: 0.72rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Control de Acceso Seguro</div>
            </div>
        </div>

        <h1 class="tl-login-title">Iniciar Sesión</h1>
        <p class="tl-login-subtitle">Ingresa tus credenciales para acceder a la plataforma logística.</p>

        @if (HttpContext.Request.Query.ContainsKey("error"))
        {
            <div class="tl-form-errors" style="margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>Usuario o contraseña incorrectos. Por favor intenta de nuevo.</span>
            </div>
        }

        <form method="post" action="/api/auth/login" class="tl-form">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="tl-form-row">
                <label for="usuario">Nombre de Usuario</label>
                <input id="usuario" name="usuario" type="text" autocomplete="username" placeholder="ej. gerente1 o agente1" required />
            </div>

            <div class="tl-form-row">
                <label for="password">Contraseña</label>
                <input id="password" name="password" type="password" autocomplete="current-password" placeholder="••••••••••••" required />
            </div>

            <div class="tl-form-actions" style="margin-top: 1rem;">
                <button type="submit" class="tl-btn tl-btn-primary" style="width: 100%; padding: 0.75rem; font-size: 0.95rem;">
                    Acceder a la plataforma →
                </button>
            </div>
        </form>

        <div class="tl-demo-users">
            <div class="tl-demo-title">Credenciales de Demostración:</div>
            <div class="tl-demo-grid">
                <div class="tl-demo-pill" onclick="document.getElementById('usuario').value='gerente1'; document.getElementById('password').value='Gerente#2026';">
                    <strong>gerente1</strong>
                    <span>GerenteBodega</span>
                </div>
                <div class="tl-demo-pill" onclick="document.getElementById('usuario').value='agente1'; document.getElementById('password').value='Agente#2026';">
                    <strong>agente1</strong>
                    <span>AgenteCampo</span>
                </div>
            </div>
            <div style="font-size: 0.7rem; color: #94a3b8; margin-top: 0.5rem; text-align: center;">
                💡 Haz clic sobre una credencial para autorrellenar el formulario
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}
