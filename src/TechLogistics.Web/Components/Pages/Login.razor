@page "/login"

<PageTitle>Iniciar sesión — TechLogistics</PageTitle>

<div class="tl-login-card">
    <h1>Iniciar sesión</h1>

    @if (HttpContext.Request.Query.ContainsKey("error"))
    {
        <p class="tl-form-errors">Usuario o contraseña incorrectos.</p>
    }

    <form method="post" action="/api/auth/login" class="tl-form">
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />

        <div class="tl-form-row">
            <label for="usuario">Usuario</label>
            <input id="usuario" name="usuario" type="text" autocomplete="username" required />
        </div>

        <div class="tl-form-row">
            <label for="password">Contraseña</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required />
        </div>

        <div class="tl-form-actions">
            <button type="submit" class="tl-btn tl-btn-primary">Ingresar</button>
        </div>
    </form>

    <p class="tl-login-hint">
        Demo: <code>gerente1 / Gerente#2026</code> (GerenteBodega) ·
        <code>agente1 / Agente#2026</code> (AgenteCampo)
    </p>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}
