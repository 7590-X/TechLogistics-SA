    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="bunit" Version="1.33.3" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TechLogistics.Components\TechLogistics.Components.csproj" />
    <ProjectReference Include="..\..\src\TechLogistics.Shared\TechLogistics.Shared.csproj" />
